# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.vert text eol=lf
*.frag text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.bmp binary
*.ico binary
*.dat binary
